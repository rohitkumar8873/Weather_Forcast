{
  "datasets": [
    {
      "name": "7c8eee6c",
      "displayName": "City",
      "queryLines": [
        "select distinct(city) from weather_forcast.gold.dim_location;"
      ],
      "catalog": "weather_forcast",
      "schema": "gold"
    },
    {
      "name": "80299528",
      "displayName": "Forcast Date",
      "queryLines": [
        "SELECT DISTINCT forecast_date\n",
        "FROM gold.fact_daily_weather\n",
        "ORDER BY forecast_date;"
      ],
      "catalog": "weather_forcast",
      "schema": "default"
    },
    {
      "name": "8e586a93",
      "displayName": "current_temperature",
      "queryLines": [
        "SELECT\n",
        "    city,\n",
        "    ROUND(current_temp,1) AS current_temperature\n",
        "FROM gold.dashboard_kpis k\n",
        "JOIN gold.dim_location d\n",
        "ON k.location_id=d.location_id;"
      ],
      "catalog": "weather_forcast",
      "schema": "default"
    },
    {
      "name": "840b47d3",
      "displayName": "KPI 2 – Humidity",
      "queryLines": [
        "SELECT\n",
        "    humidity,\n",
        "    city\n",
        "FROM gold.dashboard_kpis k\n",
        "JOIN gold.dim_location d\n",
        "ON k.location_id=d.location_id\n"
      ],
      "catalog": "weather_forcast",
      "schema": "default"
    },
    {
      "name": "aeb80575",
      "displayName": "KPI 3 – Wind Speed",
      "queryLines": [
        "SELECT\n",
        "    wind_speed,\n",
        "    city\n",
        "FROM gold.dashboard_kpis k\n",
        "JOIN gold.dim_location d\n",
        "ON k.location_id=d.location_id\n"
      ],
      "catalog": "weather_forcast",
      "schema": "default"
    },
    {
      "name": "dca9cb1f",
      "displayName": "KPI 4 – Weekly Rainfall",
      "queryLines": [
        "SELECT\n",
        "    weekly_rain,\n",
        "    city\n",
        "FROM gold.dashboard_kpis k\n",
        "JOIN gold.dim_location d\n",
        "ON k.location_id=d.location_id\n"
      ],
      "catalog": "weather_forcast",
      "schema": "default"
    },
    {
      "name": "f6c1eb7f",
      "displayName": "KPI 5 – Highest UV Index",
      "queryLines": [
        "SELECT\n",
        "    highest_uv,\n",
        "    city\n",
        "FROM gold.dashboard_kpis k\n",
        "JOIN gold.dim_location d\n",
        "ON k.location_id=d.location_id\n"
      ],
      "catalog": "weather_forcast",
      "schema": "default"
    },
    {
      "name": "eef9bc41",
      "displayName": "Hourly Temperature Trend",
      "queryLines": [
        "SELECT\n",
        "    h.forecast_time,\n",
        "    h.temperature_c,\n",
        "    d.city\n",
        "FROM gold.fact_hourly_weather h\n",
        "JOIN gold.dim_location d\n",
        "ON h.location_id = d.location_id\n",
        "-- WHERE d.city = :City\n",
        "ORDER BY h.forecast_time;"
      ],
      "catalog": "weather_forcast",
      "schema": "default"
    },
    {
      "name": "ab35ad7e",
      "displayName": "Weekly Temperature Trend",
      "queryLines": [
        "-- SELECT\n",
        "--     h.forecast_time,\n",
        "--     h.temperature_c,\n",
        "--     d.city\n",
        "-- FROM gold.fact_hourly_weather h\n",
        "-- JOIN gold.dim_location d\n",
        "-- ON h.location_id = d.location_id\n",
        "-- -- WHERE d.city = :City\n",
        "-- ORDER BY h.forecast_time;\n",
        "\n",
        "SELECT\n",
        "    f.forecast_date,\n",
        "    f.day_name,\n",
        "    f.max_temp_c,\n",
        "    f.min_temp_c,\n",
        "    -- f.feels_max_c,\n",
        "    d.city\n",
        "FROM gold.fact_daily_weather f\n",
        "JOIN gold.dim_location d\n",
        "    ON f.location_id = d.location_id\n",
        "ORDER BY f.forecast_date;"
      ],
      "catalog": "weather_forcast",
      "schema": "default"
    },
    {
      "name": "0c65b8b0",
      "displayName": "Rain Probability Trend",
      "queryLines": [
        "SELECT\n",
        "    CAST(h.forecast_time AS DATE) AS forecast_date,\n",
        "    h.rain_probability,\n",
        "    d.city\n",
        "FROM gold.fact_hourly_weather h\n",
        "JOIN gold.dim_location d\n",
        "ON h.location_id = d.location_id\n",
        "-- WHERE d.city = :City\n",
        "ORDER BY h.forecast_time;"
      ],
      "catalog": "weather_forcast",
      "schema": "default"
    },
    {
      "name": "f9a8c486",
      "displayName": "Wind Speed Trend",
      "queryLines": [
        "SELECT\n",
        "    CAST(h.forecast_time AS DATE) AS forecast_date,\n",
        "    wind_kmh,\n",
        "    d.city\n",
        "FROM gold.fact_hourly_weather h\n",
        "JOIN gold.dim_location d\n",
        "ON h.location_id=d.location_id\n",
        "-- WHERE city='{{City}}'\n",
        "ORDER BY forecast_time;"
      ],
      "catalog": "weather_forcast",
      "schema": "default"
    },
    {
      "name": "3cec9f2c",
      "displayName": "7-Day Forecast Table",
      "queryLines": [
        "SELECT\n",
        "    forecast_date,\n",
        "    day_name,\n",
        "    max_temp_c,\n",
        "    min_temp_c,\n",
        "    rainfall_mm,\n",
        "    uv_index,\n",
        "    sunrise,\n",
        "    sunset,\n",
        "    f.city\n",
        "FROM gold.fact_daily_weather f\n",
        "JOIN gold.dim_location d\n",
        "ON f.location_id=d.location_id\n",
        "-- WHERE city='{{City}}'\n",
        "ORDER BY forecast_date;"
      ],
      "catalog": "weather_forcast",
      "schema": "default"
    },
    {
      "name": "6f89f5dc",
      "displayName": "Weather Distribution",
      "queryLines": [
        "SELECT\n",
        "    temperature_category,\n",
        "    d.city,\n",
        "    COUNT(*) AS observations\n",
        "FROM gold.fact_current_weather c\n",
        "JOIN gold.dim_location d\n",
        "ON c.location_id=d.location_id\n",
        "-- WHERE city='{{City}}'\n",
        "GROUP BY temperature_category,d.city;"
      ],
      "catalog": "weather_forcast",
      "schema": "default"
    },
    {
      "name": "157c8a90",
      "displayName": "Daily UV Index Forecasts by City and Date",
      "queryLines": [
        "SELECT\n",
        "    forecast_date,\n",
        "    uv_index,\n",
        "    d.city\n",
        "FROM gold.fact_daily_weather f\n",
        "JOIN gold.dim_location d\n",
        "ON f.location_id=d.location_id\n",
        "-- WHERE city='{{City}}'\n",
        "ORDER BY forecast_date;"
      ],
      "catalog": "weather_forcast",
      "schema": "default"
    },
    {
      "name": "7e25d8b4",
      "displayName": "Sunrise vs Sunset",
      "queryLines": [
        "SELECT\n",
        "    f.forecast_date,\n",
        "    date_format(f.sunrise, 'HH:mm') AS sunrise_time,\n",
        "    date_format(f.sunset, 'HH:mm') AS sunset_time,\n",
        "    d.city\n",
        "FROM gold.fact_daily_weather f\n",
        "JOIN gold.dim_location d\n",
        "ON f.location_id = d.location_id\n",
        "-- WHERE d.city = :City\n",
        "ORDER BY f.forecast_date;"
      ],
      "catalog": "weather_forcast",
      "schema": "default"
    }
  ],
